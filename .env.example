# Copia este archivo a .env y edítalo.
# Solo es necesario para el modo producción del compose:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# En desarrollo (docker compose up) no hace falta: ya hay defaults.

# Perfil de Spring (prod por defecto en este override)
SPRING_PROFILE_ACTIVE=prod

# Base de datos (la contraseña debe coincidir con la del volumen si ya existe)
POSTGRES_PASSWORD=
URL_DB=jdbc:postgresql://db:5432/golaya_db
USERNAME_DB=postgres
PASSWORD_DB=

# Seguridad (mínimo 32 caracteres)
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma y SIN espacios
CORS_URLS=

# Cloudinary (necesario para subir imágenes en producción)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
