# ============================================================
# Variables de entorno del backend (DevPortes-Backend)
# ------------------------------------------------------------
# Con `docker compose` NO necesitas este archivo: el compose ya
# define todos los valores de desarrollo. Úsalo si corres el
# backend a mano con `./mvnw spring-boot:run`; el .env se carga
# automáticamente al arrancar.
# ============================================================

# Perfil de Spring: dev (local) o prod
SPRING_PROFILE_ACTIVE=dev

# --- Perfil dev (los defaults ya funcionan con docker compose) ---
DB_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Perfil prod ---
URL_DB=jdbc:postgresql://localhost:5432/golaya_db
USERNAME_DB=postgres
PASSWORD_DB=

# Seguridad (JWT: mínimo 32 caracteres)
JWT_SECRET=
# Orígenes permitidos para CORS, separados por coma (sin espacios)
CORS_URLS=http://localhost:8000

# Cloudinary (opcional en local; necesario para subir imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
